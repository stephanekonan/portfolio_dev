# Formulaire de contact -> API d'envoi Mailtrap (route src/app/api/contact).
# Secrets serveur : à déclarer dans Vercel (Project Settings > Environment
# Variables), jamais préfixés NEXT_PUBLIC_.

# Jeton API créé dans Mailtrap > Sending Domains > (domaine) > Integration > API.
MAILTRAP_API_TOKEN=

# Expéditeur : une adresse du domaine vérifié dans Mailtrap (SPF, DKIM, DMARC).
MAILTRAP_FROM_EMAIL=portfolio@wadibu.ci

# Destinataire des messages. Par défaut : stephanekonan.dev@gmail.com.
CONTACT_TO_EMAIL=

# Développement local : renseigner l'identifiant d'une boîte Email Testing
# pour recevoir les messages dans Mailtrap au lieu de les envoyer vraiment.
# Le jeton doit alors être celui de l'API Testing. Laisser vide en production.
MAILTRAP_SANDBOX_INBOX_ID=

# Espace privé (carnet). Les trois sont obligatoires : s'il en manque une,
# toutes ses URL répondent 404. Mêmes valeurs en local (.env.local) et dans
# Vercel. Jamais dans le dépôt : il est public.

# Premier segment de l'URL privée : https://developer.wadibu.ci/<CARNET_PATH>.
# Rien dans le code ne le nomme. Minuscules, chiffres et tirets.
CARNET_PATH=

# Code d'accès demandé au lecteur. Le changer déconnecte toutes les sessions.
# Préférer un code long : c'est lui qui protège le contenu.
CARNET_CODE=

# Valeur aléatoire longue (`openssl rand -base64 32`). Chiffre le contenu
# scellé et signe les sessions. La changer impose de resceller
# (`npm run carnet:seal`) : garder une copie dans un gestionnaire de mots de
# passe, sans elle le fichier scellé est illisible.
CARNET_SECRET=
