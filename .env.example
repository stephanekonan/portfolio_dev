# Formulaire de contact -> API d'envoi Mailtrap (route src/app/api/contact).
# Secrets serveur : à déclarer dans Vercel (Project Settings > Environment
# Variables), jamais préfixés NEXT_PUBLIC_.

# Jeton API créé dans Mailtrap > Sending Domains > (domaine) > Integration > API.
MAILTRAP_API_TOKEN=

# Expéditeur : une adresse du domaine vérifié dans Mailtrap (SPF, DKIM, DMARC).
MAILTRAP_FROM_EMAIL=portfolio@wadibu.ci

# Destinataire des messages. Par défaut : stephanekonan.dev@gmail.com.
CONTACT_TO_EMAIL=

# Développement local : renseigner l'identifiant d'une boîte Email Testing
# pour recevoir les messages dans Mailtrap au lieu de les envoyer vraiment.
# Le jeton doit alors être celui de l'API Testing. Laisser vide en production.
MAILTRAP_SANDBOX_INBOX_ID=
